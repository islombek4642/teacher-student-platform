# === Production deployment configuration ===
# Copy to .env on the server, then fill in real values before running
# scripts/deploy.sh. This file is consumed by docker-compose.prod.yml.

# 1. Database credentials
DB_USER=app
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_RANDOM_PASSWORD
DB_NAME=teacher_student

# 2. Auth
# JWT_SECRET is generated automatically by scripts/deploy.sh (via
# `openssl rand`) the first time it finds this placeholder — no need to
# fill it in by hand.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRES_IN=8h
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# 3. Domains
# Both must resolve to this server's IP. The shared nginx-proxy +
# acme-companion stack reads these to route traffic and issue Let's
# Encrypt certificates automatically.
#
# No real domain yet? Use nip.io — it's a free wildcard DNS service that
# resolves <anything>.<IP>.nip.io straight to <IP>, so it works exactly
# like a real domain (including valid Let's Encrypt certificates). If
# this server's public IP is e.g. 49.12.34.56, set:
#   API_DOMAIN=api.49.12.34.56.nip.io
#   APP_DOMAIN=app.49.12.34.56.nip.io
# Swap in a real domain later just by editing these two lines and
# re-running scripts/deploy.sh — nothing else changes.
API_DOMAIN=api.yourdomain.uz
APP_DOMAIN=app.yourdomain.uz
SSL_EMAIL=admin@example.com
