DATABASE_URL=postgresql://app:app@localhost:5432/teacher_student
DATABASE_URL_TEST=postgresql://app:app@localhost:5433/teacher_student_test
JWT_SECRET=replace-with-a-long-random-value-before-deploying
JWT_EXPIRES_IN=8h
# Encrypts the plaintext copy of teacher/student passwords stored in the DB
# (so they can be shown again in the UI). Losing/changing this key makes
# every already-stored password permanently undecryptable.
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-long-random-value-before-deploying
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password-before-deploying
PORT=3000
# Comma-separated allowed origins for CORS. Leave unset to allow any origin (dev default).
CORS_ORIGIN=
