generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TEACHER
  STUDENT
}


model User {
  id             String          @id @default(uuid())
  username       String          @unique
  passwordHash   String
  currentPassword String?
  role           Role
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
}

model TeacherProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  groups    Group[]
  ieltsTasks IeltsTask[]
  createdAt DateTime @default(now())
}

model StudentProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submissions IeltsSubmission[]
  createdAt   DateTime     @default(now())

  @@index([groupId])
}

model Group {
  id         String           @id @default(uuid())
  name       String
  teacherId  String
  teacher    TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students   StudentProfile[]
  groupTasks GroupTask[]
  ieltsTasks IeltsTask[]
  createdAt  DateTime         @default(now())

  @@index([teacherId])
}

enum IeltsTaskType {
  LISTENING
  READING
  WRITING
  SPEAKING
}

model IeltsTask {
  id          String         @id @default(uuid())
  title       String
  type        IeltsTaskType
  contentHtml String
  teacherId   String
  groupId     String?
  createdAt   DateTime       @default(now())

  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupTasks  GroupTask[]
  submissions IeltsSubmission[]

  @@index([teacherId])
  @@index([groupId])
}

model GroupTask {
  id        String   @id @default(uuid())
  groupId   String
  taskId    String
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  task      IeltsTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([groupId, taskId])
  @@index([groupId])
  @@index([taskId])
}

model IeltsSubmission {
  id           String         @id @default(uuid())
  studentId    String
  taskId       String
  score        Int
  total        Int            @default(40)
  band         Float
  attempt      Int            @default(1)
  answersJson  Json
  isGraded     Boolean        @default(false)
  criteriaJson Json?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  submittedAt  DateTime       @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task        IeltsTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([studentId, taskId, attempt])
  @@index([studentId])
  @@index([taskId])
  @@index([studentId, taskId])
}
